      "html": "<style>\n  :root{\n    --terrain-1:#25301f;\n    --terrain-2:#3a4230;\n    --terrain-3:#57503a;\n    --terrain-4:#6a6247;\n    --terrain-5:#1b2418;\n    --overlay:rgba(10,14,10,0.38);\n    --ink:#f4f4ef;\n    --ink-dim:rgba(244,244,239,0.85);\n    --field-bg:rgba(12,16,12,0.5);\n    --field-border:rgba(244,244,239,0.16);\n    --btn-bg:#ffffff;\n    --btn-ink:#161a14;\n    --sans:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n  }\n  *{box-sizing:border-box;margin:0;padding:0;}\n  body{\n    font-family:var(--sans);-webkit-font-smoothing:antialiased;color:var(--ink);\n    min-height:100vh;display:flex;flex-direction:column;background:#141a12;\n  }\n\n  .hero{\n    position:relative;flex:1;min-height:640px;\n    overflow:hidden;isolation:isolate;\n    display:flex;align-items:center;\n    padding:clamp(28px,5vw,80px) clamp(20px,6vw,110px);\n  }\n  /* aerial terrain built from layered gradients */\n  .hero::before{\n    content:\"\";position:absolute;inset:-4%;z-index:-3;\n    background:\n      radial-gradient(58% 46% at 34% 40%, var(--terrain-4) 0%, rgba(106,98,71,0) 62%),\n      radial-gradient(46% 40% at 66% 26%, var(--terrain-3) 0%, rgba(87,80,58,0) 58%),\n      radial-gradient(40% 36% at 78% 74%, var(--terrain-3) 0%, rgba(87,80,58,0) 60%),\n      radial-gradient(52% 44% at 12% 82%, var(--terrain-5) 0%, rgba(27,36,24,0) 62%),\n      radial-gradient(36% 30% at 8% 12%, var(--terrain-5) 0%, rgba(27,36,24,0) 60%),\n      radial-gradient(30% 26% at 52% 88%, var(--terrain-2) 0%, rgba(58,66,48,0) 62%),\n      linear-gradient(146deg, var(--terrain-1) 0%, var(--terrain-2) 44%, var(--terrain-1) 100%);\n    filter:saturate(.95) contrast(1.08);\n  }\n  /* mottled forest texture + faint trails */\n  .hero::after{\n    content:\"\";position:absolute;inset:-4%;z-index:-2;\n    background-image:\n      radial-gradient(rgba(16,24,14,.55) 1.6px, transparent 2.4px),\n      radial-gradient(rgba(120,124,92,.32) 1.2px, transparent 2px),\n      radial-gradient(rgba(24,30,20,.4) 2.2px, transparent 3px);\n    background-size:17px 19px, 29px 23px, 41px 37px;\n    background-position:0 0, 9px 7px, 3px 17px;\n    opacity:.32;\n    -webkit-mask:radial-gradient(120% 120% at 50% 50%, #000 30%, rgba(0,0,0,.55) 100%);\n            mask:radial-gradient(120% 120% at 50% 50%, #000 30%, rgba(0,0,0,.55) 100%);\n  }\n  /* darkening overlay for legibility */\n  .overlay{position:absolute;inset:0;z-index:-1;background:var(--overlay);}\n\n  .row{\n    width:100%;max-width:1360px;margin:0 auto;\n    display:flex;align-items:center;justify-content:space-between;\n    gap:40px;flex-wrap:wrap;\n  }\n  h1{\n    font-size:clamp(34px,4vw,56px);\n    font-weight:300;letter-spacing:.002em;\n    text-shadow:0 2px 26px rgba(10,14,10,.4);\n  }\n\n  .form{\n    display:flex;align-items:center;gap:0;\n    background:var(--field-bg);\n    border:1px solid var(--field-border);\n    border-radius:14px;\n    padding:6px 6px 6px 20px;\n    min-width:min(460px,100%);\n    backdrop-filter:blur(6px);\n    -webkit-backdrop-filter:blur(6px);\n    transition:border-color .25s ease;\n  }\n  .form:focus-within{border-color:rgba(244,244,239,.45);}\n  .form input{\n    flex:1;min-width:0;background:transparent;border:0;outline:none;\n    color:var(--ink);font-size:15.5px;padding:15px 0;font-family:var(--sans);\n  }\n  .form input::placeholder{color:var(--ink-dim);}\n  .form button{\n    flex:0 0 auto;margin-left:14px;\n    background:var(--btn-bg);color:var(--btn-ink);\n    border:0;border-radius:10px;padding:15px 26px;\n    font-size:15px;font-weight:650;cursor:pointer;font-family:var(--sans);\n    transition:transform .2s ease,opacity .2s ease;\n  }\n  .form button:hover{opacity:.92;}\n  .form button:active{transform:scale(.98);}\n\n  @media (max-width:900px){\n    .row{justify-content:flex-start;}\n  }\n</style>\n\n\n  <section class=\"hero\">\n    <div class=\"overlay\"></div>\n    <div class=\"row\">\n      <h1>Power the shift</h1>\n      <form class=\"form\" onsubmit=\"return false\">\n        <input type=\"email\" placeholder=\"Enter your email address\" aria-label=\"Email address\">\n        <button type=\"submit\">Subscribe</button>\n      </form>\n    </div>\n  </section>\n\n",
