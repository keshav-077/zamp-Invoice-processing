# Loaded from the repository root. apps/api/.env, when present, overrides this file.
#
# Database
# Local dev (no Docker): sqlite+aiosqlite:///./data/invoice.db
# Docker/Postgres:       postgresql+asyncpg://invoice:invoice@localhost:5432/invoice_processing
DATABASE_URL=sqlite+aiosqlite:///./data/invoice.db

# Relative SQLite and storage paths resolve from apps/api.
STORAGE_PATH=./data/uploads

# CORS
CORS_ORIGINS=http://localhost:3000

# Model providers (Gemini primary, Groq/OpenRouter fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.6-flash

# Filename-based demo extraction. Set false only when at least one API key is configured.
USE_MOCK_EXTRACTION=true
LOG_LEVEL=INFO

# Policy tolerances
AMOUNT_TOLERANCE_PERCENT=2.0
AMOUNT_TOLERANCE_ABSOLUTE=50.00
ROUNDING_TOLERANCE=0.05
PO_MATCH_MIN_SCORE=0.85
PO_MATCH_POSSIBLE_SCORE=0.70
PO_MATCH_MIN_MARGIN=0.10
PO_WEIGHT_REFERENCE=0.40
PO_WEIGHT_VENDOR=0.20
PO_WEIGHT_AMOUNT=0.15
PO_WEIGHT_LINE_ITEMS=0.10
PO_WEIGHT_QUANTITY=0.05
PO_WEIGHT_DATE=0.05
PO_WEIGHT_SEMANTIC=0.05
VENDOR_MATCH_MIN_SCORE=0.85
EXTRACTION_CONFIDENCE_THRESHOLD=0.75
DUPLICATE_DECISION=REVIEW
PO_CLOSED_DECISION=REJECT
PO_CANCELLED_DECISION=REJECT
CURRENCY_MISMATCH_DECISION=REJECT
AMOUNT_OVER_TOLERANCE_DECISION=REVIEW

# Auth (demo)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
